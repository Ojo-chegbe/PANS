{
  "rules": [
    {
      "allowed": {
        "origins": ["http://localhost:3000"],
        "methods": ["GET", "HEAD", "PUT"],
        "headers": [
          "Content-Type",
          "Content-Length",
          "If-None-Match",
          "Range",
          "x-amz-*"
        ]
      },
      "exposeHeaders": [
        "ETag",
        "Content-Length",
        "Content-Range",
        "Accept-Ranges"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
