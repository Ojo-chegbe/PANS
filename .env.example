# Local development runs on SQLite. Set DATABASE_URL to use PostgreSQL.
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
DATABASE_URL=
# For Neon: pooled DATABASE_URL for the app; direct URL for schema migrations.
DATABASE_URL_UNPOOLED=
# Preserve the separate local database for isolated integration checks.
LOCAL_DATABASE_URL=
# The setup helper stages these before moving existing data and activating Neon.
NEON_DATABASE_URL=
NEON_DATABASE_URL_UNPOOLED=
SQLITE_URL=file:./.data/pans.db
# Production must use PostgreSQL, private object storage, and transactional email.
# Resend is preferred when this key is set. Use a sending-access API key.
RESEND_API_KEY=
# Without a domain, onboarding@resend.dev can send only to your Resend account email.
# For production, replace this with an address on your verified domain.
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=PANS UNIJOS
# Optional SMTP alternative, used only when RESEND_API_KEY is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
S3_BUCKET=
S3_REGION=auto
# R2 S3 endpoint: https://<your-cloudflare-account-id>.r2.cloudflarestorage.com
# Use a bucket-scoped Object Read & Write R2 token. Keep all S3 values server-only.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
JOBS_SECRET=

