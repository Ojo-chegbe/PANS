{
  "name": "pans-digital-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --webpack",
    "build": "node node_modules/next/dist/bin/next build --webpack",
    "start": "node node_modules/next/dist/bin/next start",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "format": "prettier --write src scripts tests e2e playwright.config.ts next.config.mjs",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "extract:reference": "node scripts/extract-reference.mjs",
    "seed": "tsx scripts/seed.ts",
    "jobs": "tsx scripts/jobs.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:migrate": "tsx scripts/migrate-database.ts",
    "db:verify-neon": "node scripts/verify-neon.mjs",
    "storage:r2": "node scripts/r2-storage.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/db-sqlite": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/storage-s3": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "drizzle-orm": "^0.45.1",
    "graphql": "^16.11.0",
    "next": "^16.3.3",
    "nodemailer": "^7.0.11",
    "payload": "3.93.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cheerio": "^1.1.2",
    "node": "24.22.1",
    "pg": "^8.20.0",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
